    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.brd_text }}",
        "options": {
          "systemMessage": "=You are a Senior Product Owner. Your job is to extract 3-5 high-level User Stories from the provided BRD. \n\nOutput ONLY a JSON array of objects with the following schema:\n[\n  { \"id\": 1, \"title\": \"string\", \"story\": \"As a... I want... so that...\", \"domain\": \"Frontend/Backend/Security\" }\n]"
        }
      },
      "id": "984a4961-1ca6-49ad-b527-c0f433a1d892",
      "name": "PO: Decompose BRD",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        288,
        -16
      ]
    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    \"personas\": [\n      {\n        \"id\": \"architect\",\n        \"name\": \"Senior Architect\",\n        \"instructions\": \"Evaluate for system design and integration risk. Rate 1-13 Fibonacci.\",\n        \"weight\": 1.5\n      },\n      {\n        \"id\": \"dev\",\n        \"name\": \"Lead Developer\",\n        \"instructions\": \"Evaluate for coding effort and technical complexity. Rate 1-13 Fibonacci.\",\n        \"weight\": 1.0\n      },\n      {\n        \"id\": \"security\",\n        \"name\": \"Security Lead\",\n        \"instructions\": \"Evaluate for PII, data hygiene, and backup risk. Rate 1-13 Fibonacci.\",\n        \"weight\": 1.3\n      }\n    ]\n  }\n];"
      },
      "id": "9a380fd5-f7e5-4264-bd23-f9a48a220a0f",
      "name": "Manifest: Load Experts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        -208
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "dc699942-1c18-467a-9129-ccd64ae97daf",
      "name": "Loop Stories",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 1,
      "position": [
        704,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "const story = items[0].json;\nconst personas = $node[\"Manifest: Load Experts\"].json.personas;\n\nreturn personas.map(p => ({\n  json: {\n    story: story,\n    persona: p\n  }\n}));"
      },
      "id": "8271db6f-add6-4454-9387-3153abb5d83e",
      "name": "Explode: Story x Persona",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        928,
        -48
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate the 3 expert opinions for 1 story\nconst items = $input.all();\nconst story = items[0].json.story;\n\nconst totalWeightedPoints = items.reduce((acc, curr) => {\n  return acc + (curr.json.output.story_points * curr.json.persona.weight);\n}, 0);\n\nconst totalWeights = items.reduce((acc, curr) => acc + curr.json.persona.weight, 0);\nconst finalPoints = Math.ceil(totalWeightedPoints / totalWeights);\n\nreturn {\n  story_id: story.id,\n  story_text: story.story,\n  aggregated_points: finalPoints,\n  consensus_confidence: items.reduce((acc, c) => acc + c.json.output.confidence, 0) / items.length,\n  total_risks: [...new Set(items.flatMap(i => i.json.output.risks))]\n};"
      },
      "id": "edfa3571-887c-4838-aec3-79ac30972898",
      "name": "Consensus Calculator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        -48
      ]
    },
    {
