    {
      "parameters": {
        "jsCode": "\nconst run = $('03 - Build run window').first().json;\n\nconst allowedGrains = new Set(['M', 'W']);\nconst out = [];\n\nlet skipped = 0;\n\nfor (const item of $input.all()) {\n  const r = item.json;\n\n  // 1. Only explicitly approved readings\n  if (\n    String(r.approval_status || '').trim().toLowerCase()\n    !== 'approved'\n  ) {\n    skipped++;\n    continue;\n  }\n\n  // 2. Validate metric ID and reporting frequency\n  const metricId = String(r.metric_id || '').trim();\n  const grain = String(r.grain || '').trim().toUpperCase();\n\n  if (!metricId || !allowedGrains.has(grain)) {\n    skipped++;\n    continue;\n  }\n\n  // 3. Validate reporting period\n  const periodStart = String(r.period_start || '')\n    .trim()\n    .slice(0, 10);\n\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(periodStart)) {\n    skipped++;\n    continue;\n  }\n\n  const parsedDate = new Date(periodStart + 'T00:00:00Z');\n\n  if (\n    !Number.isFinite(parsedDate.getTime()) ||\n    parsedDate.toISOString().slice(0, 10) !== periodStart\n  ) {\n    skipped++;\n    continue;\n  }\n\n  // 4. Require a genuine numeric reading\n  // Blank, null, text and invalid numbers are excluded.\n  // Zero (0) remains a valid reading.\n  const rawValue = r.value_numeric;\n\n  if (\n    rawValue === null ||\n    rawValue === undefined ||\n    typeof rawValue === 'boolean' ||\n    String(rawValue).trim() === ''\n  ) {\n    skipped++;\n    continue;\n  }\n\n  const valueString = String(rawValue).trim();\n\n  if (\n    !/^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$/.test(valueString)\n  ) {\n    skipped++;\n    continue;\n  }\n\n  const value = Number(valueString);\n\n  if (!Number.isFinite(value)) {\n    skipped++;\n    continue;\n  }\n\n  // 5. Normalize identifiers and metadata\n  const scope = String(r.scope || 'ALL').trim() || 'ALL';\n\n  const metricKey =\n    `${metricId}|${grain}|${periodStart}|${scope}`;\n\n  // 6. Output valid approved readings\n  out.push({\n    json: {\n      metric_key: metricKey,\n      metric_id: metricId,\n      grain: grain,\n\n      period_start: periodStart,\n      period_end: r.period_end || '',\n\n      value_numeric: value,\n      unit: r.unit || '',\n\n      status: 'APPROVED MANUAL',\n      source: 'Google Workspace approved evidence',\n\n      updated_at: r.updated_at || new Date().toISOString(),\n      approved_by: r.approved_by || '',\n      evidence_link: r.evidence_link || '',\n\n      run_id: run.run_id,\n      notes: r.notes || '',\n      data_as_of: r.updated_at || ''\n    }\n  });\n}\n\nconsole.log(\n  `GW validation: ${out.length} accepted, ${skipped} skipped`\n);\n\nreturn out;\n"
      },
