      "id": "f97059be-7349-4663-bab8-27071eb80df9",
      "name": "04S - Get SF Opportunities",
      "type": "n8n-nodes-base.salesforce",
      "typeVersion": 1,
      "position": [
        752,
        816
      ],
      "alwaysOutputData": true,
      "credentials": {
        "salesforceOAuth2Api": {
          "id": "1JVUQfvBt7AbBSQM",
          "name": "Salesforce account"
        }
      },
      "notes": "Requires Salesforce API entitlement. This reads current Opportunity state; CloseDate is NOT guaranteed actual decision date. Update normalization before trusting win rate."
    },
    {
      "parameters": {
        "jsCode": "const run = $('03 - Build run window').first().json;\n\nfunction serial(d) {\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(String(d || ''))) return '';\n\n  return Math.round(\n    (Date.parse(d + 'T00:00:00Z') - Date.UTC(1899, 11, 30)) / 86400000\n  );\n}\n\nconst now = new Date().toISOString();\nconst out = [];\n\nfor (const item of $input.all()) {\n  const o = item.json;\n\n  if (!o.Id) continue;\n\n  const closeDate = String(\n    o.Decision_Date__c || o.CloseDate || ''\n  ).slice(0, 10);\n\n  const submitted =\n    typeof o.Proposal_Submitted__c === 'boolean'\n      ? (o.Proposal_Submitted__c ? 'Y' : 'N')\n      : 'REVIEW';\n\n  const qualified =\n    typeof o.Qualified__c === 'boolean'\n      ? (o.Qualified__c ? 'Y' : 'N')\n      : 'REVIEW';\n\n  const basis = o.Decision_Date__c\n    ? 'ACTUAL_DECISION_DATE'\n    : 'CLOSEDATE_PROXY_REVIEW';\n\n  out.push({\n    json: {\n      record_key: `SF|Opportunity|${o.Id}`,\n\n      opportunity_id: String(o.Id),\n      account_id: String(o.AccountId || ''),\n\n      // Opportunity and Account\n      name: String(o.Name || ''),\n      account_name: String(\n        o.Account?.Name || o['Account.Name'] || ''\n      ),\n\n      // Sales pipeline\n      stage: String(o.StageName || ''),\n      amount_eur:\n        o.CurrencyIsoCode && o.CurrencyIsoCode !== 'EUR'\n          ? ''\n          : Number(o.Amount || 0),\n      currency: o.CurrencyIsoCode || 'EUR',\n\n      is_closed: o.IsClosed ? 'Y' : 'N',\n      is_won: o.IsWon ? 'Y' : 'N',\n\n      // Dates\n      created_at: String(o.CreatedDate || ''),\n      closed_at: String(o.CloseDate || ''),\n\n      decision_date_iso: closeDate,\n      decision_date_serial: serial(closeDate),\n      decision_date_basis: basis,\n\n      // Sales metrics\n      proposal_submitted: submitted,\n      qualified: qualified,\n\n      // Ownership\n      owner_id: String(o.OwnerId || ''),\n      owner_name: String(\n        o.Owner?.Name || o['Owner.Name'] || ''\n      ),\n\n      // Synchronization\n      last_modified: String(o.LastModifiedDate || ''),\n      sync_at: now,\n      run_id: run.run_id\n    }\n  });\n}\n\nreturn out;"
      },
