        }
      },
      "disabled": true
    },
    {
      "parameters": {
        "resource": "invoice",
        "operation": "getAll",
        "limit": 5,
        "filters": {
          "query": "=WHERE TxnDate >= '{{ $('03 - Build run window').first().json.date_from }}' AND TxnDate <= '{{ $('03 - Build run window').first().json.date_to }}'"
        }
      },
      "id": "537ab5b1-4bbd-4e3e-b9da-74929fc993fc",
      "name": "05Q - Get QBO Invoices",
      "type": "n8n-nodes-base.quickbooks",
      "typeVersion": 1,
      "position": [
        896,
        128
      ],
      "alwaysOutputData": true,
      "credentials": {
        "quickBooksOAuth2Api": {
          "id": "pAad7tQgAEiKGvIV",
          "name": "QuickBooks Online account"
        }
      },
      "disabled": true,
      "notes": "QuickBooks OAuth2 credential must be selected. Invoice line amounts are NOT recognized revenue, and CreditMemo is a separate follow-on extraction. Set approved fee items in QBO_FEE_RULES."
    },
    {
      "parameters": {
        "jsCode": "const run=$('03 - Build run window').first().json;\nconst rules=$('04Q - Read fee rules').all().map(x=>x.json);\nconst allowed=new Set(rules.filter(x=>String(x.classification).toUpperCase()==='FEE'&&String(x.include_as_fee).toUpperCase()==='Y'&&x.approved_by).map(x=>String(x.qbo_item_id)));\nfunction serial(d){return Math.round((Date.parse(d+'T00:00:00Z')-Date.UTC(1899,11,30))/86400000);}\nconst now=new Date().toISOString();const out=[];\nfor(const item of $input.all()){\n const inv=item.json; if(!inv.Id||!inv.TxnDate)continue;\n const currency=inv.CurrencyRef?.value||'EUR';\n for(const ln of inv.Line||[]){\n  if(ln.DetailType!=='SalesItemLineDetail')continue;\n  const id=String(ln.Id??ln.LineNum??'no-line-id');\n  const itemId=String(ln.SalesItemLineDetail?.ItemRef?.value??'');\n  const amt=Number(ln.Amount??0);\n  const status=currency!=='EUR'?'FX_REVIEW':allowed.has(itemId)?'APPROVED_FEE':'UNCLASSIFIED';\n  const record={record_key:`QBO|Invoice|${inv.Id}|${id}`,object_type:'Invoice',source_id:String(inv.Id),source_line_id:id,\n    txn_date_iso:inv.TxnDate,txn_date_serial:serial(inv.TxnDate),qbo_customer_id:String(inv.CustomerRef?.value||''),\n    sales_line_amount_eur:currency==='EUR'?amt:'',approved_fee_amount_eur:status==='APPROVED_FEE'?amt:'',\n    classification:status,qbo_item_id:itemId,currency,modified_at:inv.MetaData?.LastUpdatedTime||'',sync_at:now,run_id:run.run_id,\n    note:status==='APPROVED_FEE'?'Approved item mapping; still excludes credit notes until added':'Requires item and FX mapping; NOT revenue'};\n  out.push({json:record});\n }\n}\nreturn out;"
      },
