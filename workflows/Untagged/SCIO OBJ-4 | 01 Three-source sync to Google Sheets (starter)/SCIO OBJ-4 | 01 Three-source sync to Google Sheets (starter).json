    {
      "parameters": {
        "jsCode": "// SCIO monthly/weekly source refresh window. Inclusive calendar dates in Europe/Vienna.\n// For historical backfill, edit the \"02 - backfill inputs\" node. This fetches transactions by date;\n// it must never infer old pipeline stages from the current Salesforce Opportunity state.\nconst p=$input.first().json;\nconst pad=n=>String(n).padStart(2,'0');\nconst fmt=d=>`${d.getUTCFullYear()}-${pad(d.getUTCMonth()+1)}-${pad(d.getUTCDate())}`;\nconst utc=(y,m,d)=>new Date(Date.UTC(y,m,d));\nconst today=new Date(); const d=utc(today.getUTCFullYear(),today.getUTCMonth(),today.getUTCDate());\nlet from,to;\nif (p.mode==='weekly') { const start=new Date(d); start.setUTCDate(start.getUTCDate()-90); from=fmt(start); to=fmt(d); }\nelse if (p.mode==='monthly') { const monthStart=utc(d.getUTCFullYear(),d.getUTCMonth(),1);const threeBack=utc(monthStart.getUTCFullYear(),monthStart.getUTCMonth()-3,1);const through=new Date(monthStart);through.setUTCDate(through.getUTCDate()-1);from=fmt(threeBack);to=fmt(through); }\nelse { from=p.backfill_from;to=p.backfill_through; }\nif(!/^\\d{4}-\\d{2}-\\d{2}$/.test(from)||!/^\\d{4}-\\d{2}-\\d{2}$/.test(to)||from>to)throw Error('Invalid from/through dates');\nreturn [{json:{mode:p.mode,date_from:from,date_to:to,run_id:`SCIO_${p.mode}_${Date.now()}`,run_at:new Date().toISOString()}}];"
      },
      "id": "416ad78f-4701-43a2-9ab1-1151bf678dd4",
      "name": "03 - Build run window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        432,
        816
      ]
    },
    {
      "parameters": {
        "content": "# SCIO OBJ-4 · Phase 1 ingestion starter\n**Not connected or activated.** After importing: set the spreadsheet ID in ALL Google Sheets nodes, authenticate QBO/Salesforce/Google, approve QuickBooks item classifications, map SF proposal-submitted + decision-date fields. Test manual backfill on a small window before enabling schedules.\n\nThis workflow upserts source records and approved manual readings. The workbook contains provisional formulas for a small pilot KPI subset. It does **not** yet automate P&L fetching, credit notes, cross-client mapping, historical pipeline reconstruction, or immutable revision auditing.",
        "height": 550,
        "width": 510,
        "color": 4
      },
      "id": "72b597a6-20ed-4942-9ad4-3523fd7ee6d2",
      "name": "INFO - SETUP FIRST",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -112,
        -144
      ]
    },
    {
