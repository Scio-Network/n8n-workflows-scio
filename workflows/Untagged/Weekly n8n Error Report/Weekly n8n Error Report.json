    {
      "parameters": {
        "jsCode": "const workflowList = $items(\"Get All Workflows\")[0].json.data;\nconst workflowMap = {};\n\nworkflowList.forEach(w => {\n  workflowMap[w.id] = w.name;\n});\n\nconst executionList = $items(\"Get Failed Executions\")[0].json.data;\nconst lastWeek = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);\n\nconst recentErrors = executionList.filter(e => new Date(e.stoppedAt) > lastWeek);\n\nif (recentErrors.length === 0) return [];\n\nconst summary = {};\nrecentErrors.forEach(err => {\n  const id = err.workflowId;\n  const name = workflowMap[id] || \"Deleted/Unknown Workflow\";\n  \n  if (!summary[id]) {\n    summary[id] = {\n      name: name,\n      count: 0,\n      workflowLink: `https://scionetwork.app.n8n.cloud/workflow/${id}`,\n      lastExecutionLink: `https://scionetwork.app.n8n.cloud/execution/${err.id}`\n    };\n  }\n  summary[id].count++;\n});\n\nlet report = \"### 📊 Weekly n8n Error Summary\\n\";\nreport += `*Reporting Period: ${lastWeek.toLocaleDateString()} to ${new Date().toLocaleDateString()}*\\n\\n`;\nreport += `Total failed execution events: **${recentErrors.length}**\\n\\n`;\nreport += \"| Workflow Name | Failures | Action |\\n\";\nreport += \"| :--- | :---: | :--- |\\n\";\n\nfor (const id in summary) {\n  const item = summary[id];\n  // link to the Workflow Editor and the specific Execution\n  report += `| **${item.name}** | ${item.count} | [Open Workflow](${item.workflowLink}) / [View Error](${item.lastExecutionLink}) |\\n`;\n}\n\nreturn [{ json: { report, count: recentErrors.length } }];"
      },
